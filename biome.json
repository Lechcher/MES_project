{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!.agents",
			"!**/.agents",
			"!skills-lock.json",
			"!backend/drizzle",
			"!**/backend/drizzle",
			"!frontend/tests/e2e/test-results",
			"!frontend/tests/e2e/playwright-report",
			"!frontend/.sentry"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"tailwind": "all"
		},
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noTailwindArbitraryValue": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
