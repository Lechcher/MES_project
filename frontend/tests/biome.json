{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "extends": ["../biome.json"],
  "files": {
    "includes": ["**/*.spec.ts", "**/*.ts", "**/*.tsx"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  }
}