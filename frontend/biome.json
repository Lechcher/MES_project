{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "extends": ["../biome.json"],
  "files": {
    "includes": [
      "!node_modules",
      "!.next",
      "!**/.next",
      "!dist",
      "!**/dist",
      "!build",
      "!**/build"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "noTailwindArbitraryValue": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
