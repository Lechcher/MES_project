diff --git a/src/util/parentTheme.ts b/src/util/parentTheme.ts
new file mode 100644
index 000000000..01758473c
--- /dev/null
+++ b/src/util/parentTheme.ts
@@ -0,0 +1,56 @@
+import { getGlobal, setGlobal } from '../global';
+
+import type { ThemeKey } from '../types';
+
+import { updateSharedSettings } from '../global/reducers';
+import switchTheme from './switchTheme';
+
+const THEME_PARAMETER = 'theme';
+const MESSAGE_SOURCE = 'mes';
+
+let parentTheme: ThemeKey | undefined;
+
+export function parseThemeKey(raw: unknown): ThemeKey | undefined {
+  return raw === 'light' || raw === 'dark' ? raw : undefined;
+}
+
+export function getParentTheme(): ThemeKey | undefined {
+  return parentTheme;
+}
+
+export function applyParentTheme(withAnimation: boolean): void {
+  // Re-assert the MES override after every theme application, so a late
+  // account-settings sync cannot revert the embedded presentation
+  if (!parentTheme) return;
+  switchTheme(parentTheme, withAnimation);
+}
+
+function handleParentThemeMessage(event: MessageEvent) {
+  // Only the embedding MES window may drive the theme; every other source,
+  // origin, or payload shape is ignored
+  if (event.source !== window.parent) return;
+  if (event.origin !== globalThis.location.origin) return;
+  const data = event.data as { source?: unknown; theme?: unknown };
+  if (data?.source !== MESSAGE_SOURCE) return;
+  const theme = parseThemeKey(data.theme);
+  if (!theme) return;
+
+  parentTheme = theme;
+
+  let global = getGlobal();
+  global = updateSharedSettings(global, { theme, shouldUseSystemTheme: false });
+  setGlobal(global);
+
+  // The shared-settings callback only re-applies the theme when the stored
+  // theme differs, so re-assert directly to cover a sticky embedded session
+  applyParentTheme(document.hasFocus());
+}
+
+export function initParentTheme(): void {
+  const parameter = new URLSearchParams(globalThis.location.search).get(THEME_PARAMETER);
+  const fromParameter = parseThemeKey(parameter);
+  if (fromParameter) {
+    parentTheme = fromParameter;
+  }
+  window.addEventListener('message', handleParentThemeMessage);
+}
