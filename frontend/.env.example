# MES frontend configuration.
# Copy to `.env.local` for local development. `.env*` files are gitignored;
# only this example is tracked. Never commit real secrets.

# Base URL of the MES backend API.
#
# The frontend's same-origin route handlers (`/api/mes/session` and
# `/api/mes/graphql`) call the backend from the server, so this value is never
# exposed to the browser. It must point at the running backend service.
#
# Local development default:
MES_API_URL=http://localhost:3001
#
# Example production value:
# MES_API_URL=https://api.mes.example.com

# --- Sentry error tracking --------------------------------

# Sentry Data Source Name for the frontend (Next.js client SDK).
# Found in your Sentry project settings under "Client Key (DSN)".
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment name (development | staging | production).
# Controls which Sentry project events are sent to and the sampling rate.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry organization slug (used by the Sentry CLI for source map upload).
SENTRY_ORG=

# Sentry project slug (used by the Sentry CLI for source map upload).
SENTRY_PROJECT=

# Sentry auth token (used by the Sentry CLI for source map upload).
# Create at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
