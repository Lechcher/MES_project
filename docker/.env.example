# MES container stack configuration.
#
# Copy to `docker/.env` (gitignored) and fill in real values. Compose reads this
# file for the ${VAR} substitutions in docker-compose.yml. Never commit `docker/.env`.

# --- Public origin ------------------------------------------------------------

# The single origin a browser uses (Caddy). Keep `localhost` so the frontend's
# Secure session cookie is accepted over plain HTTP; see docs/DEVELOPMENT.md.
MES_PUBLIC_ORIGIN=http://localhost:8080

# --- Backend auth -------------------------------------------------------------

# Signs Better Auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- PostgreSQL (consumed by the postgres service) ----------------------------

# Password of the `mes` database role, baked into the backend's
# MES_DATABASE_URL at compose interpolation. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Garage S3 secrets (consumed by the garage service) -----------------------

# 32-byte hex shared secret for inter-node RPC. Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Admin API token (garage CLI / admin endpoint). Generate: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# Prometheus metrics token.
GARAGE_METRICS_TOKEN=

# --- Monitoring (Grafana, served behind Caddy at /grafana) -------------------

# Grafana's own admin sign-in — the second auth layer behind Caddy's basic
# auth. Generate: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# HTTP basic auth in front of Grafana: the username plus a bcrypt HASH (never
# the plaintext password). Generate the hash with:
#   docker run --rm docker.io/library/caddy:2 caddy hash-password --plaintext 'your-password'
GRAFANA_BASIC_AUTH_USER=admin
GRAFANA_BASIC_AUTH_HASH=

# The HTTP port Grafana binds inside the stack, and the upstream Caddy proxies
# to. Leave both at the defaults for a compose bring-up. In the shared-namespace
# (pod) fallback the web client owns port 3000, so move Grafana there and set
# BOTH together (see docs/DEVELOPMENT.md §14, "shared network namespace"):
GRAFANA_HTTP_PORT=3000
GRAFANA_UPSTREAM=grafana:3000

# Where Caddy proxies the web client. Leave at the default for a compose
# bring-up; in the shared-namespace (pod) fallback the web client binds the
# namespace's primary address rather than loopback, so set this to the pod's
# name (e.g. `mes:3000` for a pod created with `docker pod create --name mes`).
MES_FRONTEND_UPSTREAM=frontend:3000

# --- Attachment storage (from `./init-garage.sh`) -----------------------------

S3_BUCKET=ticket-jobs-attachment-files
S3_ACCESS_KEY_ID=GK...
S3_SECRET_ACCESS_KEY=...

# --- Mail (captured by Mailpit) -----------------------------------------------

MES_SMTP_URL=smtp://mailpit:1025
MES_RESET_EMAIL_FROM=no-reply@mes.local

# --- Sentry (frontend, build-time) --------------------------------------------
# NEXT_PUBLIC_* values are inlined at image build; changing them needs a rebuild.

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# --- Telegram bot (optional) --------------------------------------------------

TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_AI_BASE_URL=https://api.openai.com/v1
TELEGRAM_AI_API_KEY=
TELEGRAM_AI_MODEL=gpt-4o-mini
