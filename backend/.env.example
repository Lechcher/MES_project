# MES backend configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.

# --- Required -------------------------------------------------------------

# Secret used to sign Better Auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the backend service, used by Better Auth to build callback links.
BETTER_AUTH_URL=http://localhost:3001

# --- Optional (sensible local defaults) -----------------------------------

# PostgreSQL connection URL. Local default matches the Docker instance in
# docs/DEVELOPMENT.md §1; the stack sets its own (docker/.env: POSTGRES_PASSWORD).
MES_DATABASE_URL=postgres://mes:mes@localhost:5432/mes

# Port the Elysia HTTP service listens on.
MES_API_PORT=3001

# Browser origin allowed by CORS (the Next.js frontend in development).
MES_WEB_ORIGIN=http://localhost:3000

# Directory where generated print/export artifacts are written.
MES_EXPORT_DIR=./data/exports

# Service environment: development | test | production.
# Sample records and demo credentials are only seeded in development/test.
NODE_ENV=development

# --- Password reset delivery ---------------------------------------------

# Sender identity used for password-reset mail. With a hosted provider this must
# be the authenticated account (or a verified alias), or the server rejects it.
MES_RESET_EMAIL_FROM=no-reply@mes.local

# SMTP endpoint used to deliver password-reset mail. The URL selects the mode:
#
#   hosted provider, TLS from the start   smtps://<user>:<app-password>@smtp.zoho.com:465
#   hosted provider, upgraded to TLS      smtp://<user>:<app-password>@smtp.zoho.com:587
#   local mail server, no TLS or auth     smtp://localhost:1025
#
# A hosted provider generally requires an app-specific password rather than the
# account password, and IMAP/SMTP access enabled on the mailbox. Percent-encode
# any of @ : / # ? & % that appears in the password.
#
# Leave unset to disable delivery: the API then reports an explicit
# unavailable-mail-sender failure instead of pretending the mail was sent.
MES_SMTP_URL=

# --- Ticket attachment storage (Garage S3) -------------------------------

# Endpoint of the Garage S3 API. Use http://localhost:3900 when the stack runs
# on this machine (docker compose up -d); use http://garage:3900 when the
# backend joins the compose network. See docs/garage-s3-clients.md.
S3_ENDPOINT=http://localhost:3900

# Region. Garage's own region name is `garage`; the default is wrong for it
# (see the troubleshooting table in docs/garage-s3-clients.md).
S3_REGION=garage

# Bucket that holds ticket attachments. Create it and grant the key with:
#   garage bucket create ticket-jobs-attachment-files
#   garage key create mes-system-s3-bucket
#   garage bucket allow --read --write ticket-jobs-attachment-files --key mes-system-s3-bucket
#   garage key info mes-system-s3-bucket --show-secret
S3_BUCKET=ticket-jobs-attachment-files

# Access key ID (GK...) and its secret, from `garage key info ... --show-secret`.
S3_ACCESS_KEY_ID=GK...
S3_SECRET_ACCESS_KEY=...

# Maximum size of one uploaded file (bytes). Default 26214400 (25 MB).
MES_UPLOAD_MAX_FILE_BYTES=26214400

# Maximum number of files one POST /api/v1/files request may carry. Default 20.
MES_UPLOAD_MAX_FILES_PER_REQUEST=20

# --- Sentry error tracking ------------------------------

# Sentry Data Source Name for the backend.
# Found in your Sentry project settings under "Client Key (DSN)".
SENTRY_DSN=

# Sentry environment name (development | staging | production).
SENTRY_ENVIRONMENT=development

# Traces sample rate for performance monitoring (0.0 to 1.0).
# Defaults to 0.01 in production, 1.0 otherwise.
SENTRY_TRACES_SAMPLE_RATE=

# --- Service run logs ------------------------------------------------------
#
# The service records its lifecycle, unhandled failures, GraphQL request
# failures, and mail delivery outcomes — one line per event, to the terminal
# and to a log file. Credential material never reaches either one. See
# "Reading the logs" in docs/DEVELOPMENT.md.

# Directory the log files are written to. Created at startup, so an unusable
# path fails the run with an actionable message instead of at the first event.
MES_LOG_DIR=./data/logs

# Minimum recorded severity: debug | info | warn | error.
# The default records lifecycle and errors only, so a real problem stands out.
MES_LOG_LEVEL=info

# Base name of the live log file. Rolled files are numbered beside it
# (mes-backend.1.log, mes-backend.2.log, ...).
MES_LOG_FILE=mes-backend.log

# Size at which the live log file rolls, in bytes. Default 5242880 (5 MB).
MES_LOG_MAX_BYTES=5242880

# Number of rolled log files retained besides the live one. Default 3.
# The oldest is discarded first once the bound is reached.
MES_LOG_KEEP_FILES=3

# --- Inbound Telegram bot (openspec/changes/add-telegram-bot) -----
#
# The bot runs inside the backend process and receives updates by long
# polling, so no public URL is required. Every value here is a *bootstrap
# default*: anything also saved in Settings -> Telegram on the website
# overrides it, and a per-user model choice overrides the default model.
# The website settings editor is the source of truth once configured.

# Enable the bot (true/false). Disabled keeps the bot inert — no polling,
# no token use. A website save can flip this without a restart.
TELEGRAM_BOT_ENABLED=false

# Bot token from @BotFather. Never commit the real value; this file is the
# example, .env is gitignored.
TELEGRAM_BOT_TOKEN=

# Base URL of the OpenAI-compatible endpoint the agent calls (OpenAI,
# a gateway, Ollama, vLLM, OpenRouter, ...). Leave empty to disable /ask.
TELEGRAM_AI_BASE_URL=https://api.openai.com/v1

# API key for that endpoint. Empty is valid for endpoints that need none.
TELEGRAM_AI_API_KEY=

# Default model id for /ask. The available catalog is fetched from
# <TELEGRAM_AI_BASE_URL>/models and can be switched per user in the bot.
TELEGRAM_AI_MODEL=gpt-4o-mini

# Per-user /ask query ceiling per 30-day window. Default 100.
TELEGRAM_AI_MONTHLY_QUOTA=100

# Lifetime of a website-generated bot link code, in minutes. Default 10.
TELEGRAM_LINK_CODE_TTL_MINUTES=10

# --- Multi-account Telegram web client
#
# The Telegram module links a viewer's own Telegram accounts to their MES
# account and restores them in the browser. Their MTProto session strings are
# bearer credentials, so they are stored only encrypted with this key.

# 32-byte AES key as 64 hex characters. Generate with: openssl rand -hex 32
# Leave unset to disable linking: the API then refuses to store a session with
# an actionable configuration error instead of falling back to no encryption.
# None of the key material is ever logged or included in error messages.
TELEGRAM_ENCRYPTION_KEY=
