# MES backend configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.

# --- Required -------------------------------------------------------------

# Secret used to sign Better Auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the backend service, used by Better Auth to build callback links.
BETTER_AUTH_URL=http://localhost:3001

# --- Optional (sensible local defaults) -----------------------------------

# SQLite database file. Relative paths resolve against the backend directory.
MES_DATABASE_PATH=./data/mes.db

# Port the Elysia HTTP service listens on.
MES_API_PORT=3001

# Browser origin allowed by CORS (the Next.js frontend in development).
MES_WEB_ORIGIN=http://localhost:3000

# Directory where generated print/export artifacts are written.
MES_EXPORT_DIR=./data/exports

# Service environment: development | test | production.
# Sample records and demo credentials are only seeded in development/test.
NODE_ENV=development

# --- Password reset delivery ---------------------------------------------

# Sender identity used for password-reset mail. With a hosted provider this must
# be the authenticated account (or a verified alias), or the server rejects it.
MES_RESET_EMAIL_FROM=no-reply@mes.local

# SMTP endpoint used to deliver password-reset mail. The URL selects the mode:
#
#   hosted provider, TLS from the start   smtps://<user>:<app-password>@smtp.zoho.com:465
#   hosted provider, upgraded to TLS      smtp://<user>:<app-password>@smtp.zoho.com:587
#   local mail server, no TLS or auth     smtp://localhost:1025
#
# A hosted provider generally requires an app-specific password rather than the
# account password, and IMAP/SMTP access enabled on the mailbox. Percent-encode
# any of @ : / # ? & % that appears in the password.
#
# Leave unset to disable delivery: the API then reports an explicit
# unavailable-mail-sender failure instead of pretending the mail was sent.
MES_SMTP_URL=

# --- Ticket attachment storage (Garage S3) -------------------------------

# Endpoint of the Garage S3 API. Use http://localhost:3900 when the stack runs
# on this machine (docker compose up -d); use http://garage:3900 when the
# backend joins the compose network. See docs/garage-s3-clients.md.
S3_ENDPOINT=http://localhost:3900

# Region. Garage's own region name is `garage`; the default is wrong for it
# (see the troubleshooting table in docs/garage-s3-clients.md).
S3_REGION=garage

# Bucket that holds ticket attachments. Create it and grant the key with:
#   garage bucket create ticket-jobs-attachment-files
#   garage key create mes-system-s3-bucket
#   garage bucket allow --read --write ticket-jobs-attachment-files --key mes-system-s3-bucket
#   garage key info mes-system-s3-bucket --show-secret
S3_BUCKET=ticket-jobs-attachment-files

# Access key ID (GK...) and its secret, from `garage key info ... --show-secret`.
S3_ACCESS_KEY_ID=GK...
S3_SECRET_ACCESS_KEY=...

# Maximum size of one uploaded file (bytes). Default 26214400 (25 MB).
MES_UPLOAD_MAX_FILE_BYTES=26214400

# Maximum number of files one POST /api/v1/files request may carry. Default 20.
MES_UPLOAD_MAX_FILES_PER_REQUEST=20

# --- Sentry error tracking ------------------------------

# Sentry Data Source Name for the backend.
# Found in your Sentry project settings under "Client Key (DSN)".
SENTRY_DSN=

# Sentry environment name (development | staging | production).
SENTRY_ENVIRONMENT=development

# Traces sample rate for performance monitoring (0.0 to 1.0).
# Defaults to 0.01 in production, 1.0 otherwise.
SENTRY_TRACES_SAMPLE_RATE=
