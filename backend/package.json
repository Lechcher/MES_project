{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"lint": "biome check",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"contract-diff": "bun run contract-diff.ts"
	},
	"dependencies": {
		"better-auth": "^1.7.7",
		"bun": "^1.4.2",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.30",
		"exceljs": "^4.4.0",
		"graphql": "^16.14.2",
		"nodemailer": "^10.1.7",
		"pdf-lib": "^1.17.1",
		"@sentry/node": "^8.40.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5"
	}
}
